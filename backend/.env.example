# Copy to .env and replace SECRET_KEY before running outside a local demo.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./scheme2action.db
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=60
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional first admin; registration never permits self-assigned admin roles.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
